graph_investigation_service = GraphInvestigationService()

@app.get(
    "/graph/{node_id}",
    response_model=GraphResponse,
    tags=["graph"],
)
def investigate_graph(
    node_id: int,
    node_type: str,
) -> GraphResponse:
    """Return the one-hop graph neighborhood of a node."""

    graph_index = getattr(
        app.state,
        "graph_index",
        None,
    )

    if graph_index is None:
        raise HTTPException(
            status_code=503,
            detail="Graph investigation service is unavailable.",
        )

    try:
        return graph_investigation_service.investigate(
            node_type=node_type,
            node_id=node_id,
            index=graph_index,
        )

    except GraphInvestigationServiceError as exc:
        message = str(exc)

        if (
            message.startswith("Unknown ")
            or message.startswith(
                "Unsupported graph node type"
            )
        ):
            raise HTTPException(
                status_code=404,
                detail=message,
            ) from exc

        raise HTTPException(
            status_code=503,
            detail="Graph investigation service is unavailable.",
        ) from exc