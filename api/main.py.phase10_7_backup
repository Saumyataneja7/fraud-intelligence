API_VERSION = "1.0.0"
SERVICE_NAME = "fraud-intelligence-api"


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Initialize application resources."""

    graph_service = GraphInvestigationService()

    try:
        app.state.graph_index = (
            graph_service.build_index()
        )
    except GraphInvestigationServiceError:
        app.state.graph_index = None

    yield

    app.state.graph_index = None


app = FastAPI(
    title="Fraud Intelligence API",
    description=(
        "Production-style API for the Fraud Intelligence "
        "investigation platform."
    ),
    version=API_VERSION,
    lifespan=lifespan,
)


